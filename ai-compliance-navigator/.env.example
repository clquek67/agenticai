# Copy to .env.local and fill in values from your DEDICATED self-hosted
# Supabase instance (its own Kong gateway port/subdomain — not the instance
# serving your other apps). Never commit .env.local.

# Public URL of the dedicated instance's Kong gateway, e.g.
# https://compliance-db.example.com
NEXT_PUBLIC_SUPABASE_URL=

# Anon key generated from THIS instance's JWT secret
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key from THIS instance — server-side only, bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key for AI gap analysis (Phase 4)
ANTHROPIC_API_KEY=
